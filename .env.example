# ── Environment for the IHG demo ────────────────────────────────────
# Set BOTH of these on the Vercel project (Production + Preview).

# Attaches the mock-API adapter that serves the whole demo. This is a
# NEXT_PUBLIC_ var, so it is baked in at BUILD time — without it the app
# ships pointing at a real API that does not exist and every screen fails.
NEXT_PUBLIC_DEMO_MODE=1

# Signs the session cookie. Any long random string; rotate to invalidate
# every live session. Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
